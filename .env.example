# ---------------------------------------------------------------------------
# Copy to .env and fill in the secrets before first run:
#     cp .env.example .env          (Linux/macOS)
#     Copy-Item .env.example .env   (PowerShell)
#
# Generate a secret in PowerShell:
#     -join ((48..57)+(97..102) | Get-Random -Count 64 | % {[char]$_})
#
# Or with openssl / WSL:
#     openssl rand -hex 32
# ---------------------------------------------------------------------------

# --- Ollama ----------------------------------------------------------------
# Which GPU Ollama may use. Your display card is 0; the idle compute card is 1.
OLLAMA_GPU=1
OLLAMA_PORT=11434

# Where Open WebUI looks for Ollama.
#   Native Ollama on Windows:  http://host.docker.internal:11434
#   Containerised Ollama:      http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Open WebUI ------------------------------------------------------------
WEBUI_PORT=3000
WEBUI_AUTH=true
WEBUI_SECRET_KEY=CHANGE_ME_64_HEX_CHARS

# --- Qdrant ----------------------------------------------------------------
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
# Leave blank for no auth on a single-user local lab.
QDRANT_API_KEY=

# --- Postgres (Langfuse backing store) -------------------------------------
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=langfuse

# --- Langfuse --------------------------------------------------------------
LANGFUSE_PORT=3001
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME_64_HEX_CHARS
LANGFUSE_SALT=CHANGE_ME_64_HEX_CHARS
# Must be exactly 64 hex characters (32 bytes).
LANGFUSE_ENCRYPTION_KEY=CHANGE_ME_EXACTLY_64_HEX_CHARS
# Flip to true once you have created your account.
LANGFUSE_DISABLE_SIGNUP=false

# --- pgvector (optional, --profile pgvector) -------------------------------
PGVECTOR_PORT=5433
PGVECTOR_USER=rag
PGVECTOR_PASSWORD=CHANGE_ME
PGVECTOR_DB=rag

# --- Metrics (optional, --profile metrics) ---------------------------------
GPU_EXPORTER_PORT=9835
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME
